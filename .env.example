# Desktop app backend configuration (loaded by desktop/app.go via godotenv)
#
# Transport resolution order (highest priority first):
#   1. USE_MOCK=true       -> in-process HTTP mock (frontend-only dev)
#   2. BACKEND_URL set     -> external HTTP backend, manual dev (no spawn)
#   3. otherwise           -> spawn the backend CLI over STDIO
#
# NOTE: values exported in the environment take
# precedence over these because dotenv never overrides existing environment
# variables.

# --- Frontend-only dev: in-process mock API (no backend process) ---
USE_MOCK=false

# --- Manual dev: external HTTP backend (no spawn) ---
# BACKEND_URL=http://127.0.0.1:3000